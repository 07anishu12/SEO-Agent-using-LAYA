# ==============================================================================
# SEOJEV Production Environment Configuration Template (.env.production.example)
#
# INSTRUCTIONS:
# Copy this file to .env in your production environment and populate with
# genuine, high-entropy secrets and production infrastructure endpoints.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Environment Identifier
ENV=production
ENVIRONMENT=production

# Database Configuration (PostgreSQL)
# Must point to your dedicated PostgreSQL 15+ cluster with connection credentials
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
POSTGRES_DB=seojev_production
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_PORT=5432

# Redis Queue & PubSub Configuration
# Must point to your production Redis 7+ instance
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>/0
REDIS_PORT=6379
SEOJEV_MAX_QUEUE_SIZE=10000

# S3 / MinIO Object Storage Configuration
# Must use TLS and genuine credentials; minioadmin default credentials are rejected in production
S3_ENDPOINT_URL=https://<S3_ENDPOINT_OR_STORAGE_HOST>
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>
S3_BUCKET=seojev-production-artifacts
S3_REGION=us-east-1

# Authentication & Security
# JWT_SECRET must be at least 32 characters of high-entropy randomness
JWT_SECRET=<MINIMUM_32_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g., https://app.seojev.ai,https://seojev.ai)
CORS_ORIGINS=https://<YOUR_PRODUCTION_DOMAIN>

# Host and Port for API Server
HOST=0.0.0.0
PORT=8000

# Workers and Schedulers
ENABLE_WORKER=true
ENABLE_SCHEDULER=true

# Production Runtime & Resource Budgeting (Overrides config.yaml prod profile)
SEOJEV_MAX_URLS=5000000
SEOJEV_MEMORY_BUDGET_MB=32768
SEOJEV_MIN_AVAILABLE_MB=4096
SEOJEV_MAX_SWAP_DELTA_MB=128
SEOJEV_MAX_WORKERS=8
SEOJEV_BATCH_SIZE=32
SEOJEV_QUEUE_SIZE=64

# Laya-MLX Settings
# Native Apple Silicon inference boundary. Checkpoint must be locally installed or HuggingFace accessible.
LAYA_BACKEND=mlx
LAYA_MODEL_ID=aac6fef/laya-mlx

# ==============================================================================
# SEOJEV Local Development Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seojev_test
POSTGRES_DB=seojev_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Queue & PubSub Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=seojev-artifacts
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Authentication & Security
JWT_SECRET=seojev_jwt_secret_development_change_in_prod_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
